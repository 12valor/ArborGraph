<UserControl x:Class="DiskScope.Views.JunkCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:DiskScope.Infrastructure"
             xmlns:models="clr-namespace:DiskScope.Models"
             xmlns:vm="clr-namespace:DiskScope.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Junk &amp; Cache Cleaner" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Temporary files, crash dumps, browser caches, and system junk" 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Actions Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Deselect" Command="{Binding DeselectAllCommand}" 
                        Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0"/>

                <Button Content="Scan Caches" Command="{Binding ScanCommand}" 
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>

                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" 
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>

                <Button Content="{Binding FormattedPotentialBytes, StringFormat='Clean Selected ({0})'}" 
                        Command="{Binding CleanCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,6"/>

                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- SUMMARY STRIP -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Total Cleanable: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding FormattedFoundBytes}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Text="{Binding TotalFoundFiles, StringFormat='  ({0:N0} files)'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Selected to Clean: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding FormattedPotentialBytes}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="Locked &amp; in-use files bypassed safely" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- PROGRESS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"/>
                </Grid>
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" Background="{StaticResource BrushBgCardHover}" Foreground="{StaticResource BrushAccent}"/>
            </StackPanel>
        </Border>

        <!-- MAIN CATEGORIZED LIST -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:JunkCategoryGroup}">
                        <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <!-- Category Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding TotalFiles, StringFormat=' ({0:N0} files)'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{StaticResource BrushAccentTint}" CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding FormattedTotalBytes}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" FontFamily="{StaticResource MonoFont}"/>
                                    </Border>
                                </Grid>

                                <Separator Margin="0,0,0,8"/>

                                <!-- Targets Inside Category -->
                                <ItemsControl ItemsSource="{Binding Targets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:JunkTarget}">
                                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,4" Padding="6,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                        <TextBlock Text="{Binding Path}" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
