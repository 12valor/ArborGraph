<UserControl x:Class="DiskScope.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Duplicate Files" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Cryptographically verified duplicate detection via SHA-256 hash comparison" 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding StartAnalysisCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Start Analysis" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelAnalysisCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Stop24" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource ActionButtonStyle}" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status & Recoverable Space Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Known estimated allocated bytes: " Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding FormattedTotalWasted}" Foreground="{StaticResource BrushWarning}" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Duplicate Groups List -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DUPLICATE GROUPS" Style="{StaticResource SectionHeadingStyle}" Margin="4,2,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,8" Margin="0,1" Background="Transparent" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedWasted, StringFormat='Estimated allocation {0}'}"
                                                       FontWeight="Medium" Foreground="{StaticResource BrushWarning}" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} copies'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ShortHash, StringFormat='SHA: {0}'}" 
                                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Files in Selected Group -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selection & Cleaning Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Select: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Command="{Binding SelectKeepOldestCommand}" Style="{StaticResource ActionButtonStyle}" FontSize="11" Padding="8,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Keep Oldest" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SelectKeepNewestCommand}" Style="{StaticResource ActionButtonStyle}" FontSize="11" Padding="8,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Keep Newest" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="SelectAllOff24" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Deselect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding CleanSelectedRecycleBinCommand}" Style="{StaticResource PrimaryButtonStyle}" FontSize="11" Padding="10,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Recycle Selected" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CleanSelectedPermanentlyCommand}" Style="{StaticResource DangerButtonStyle}" FontSize="11" Padding="10,3">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DeleteDismiss24" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Delete..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Files DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedGroup.Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Open File" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <MenuItem Header="Open File Location" Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Separator/>
                                            <MenuItem Header="Copy Absolute Path" Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <MenuItem Header="Properties" Command="{Binding DataContext.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Separator/>
                                            <MenuItem Header="Move to Recycle Bin" Command="{Binding DataContext.MoveFileToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <MenuItem Header="Permanently Delete..." Command="{Binding DataContext.DeleteFilePermanentlyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35"/>

                            <DataGridTextColumn Header="File Name" Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDate, Converter={StaticResource DateTimeToStringConverter}}" Width="140"/>

                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, Converter={StaticResource DateTimeToStringConverter}}" Width="140"/>

                            <DataGridTextColumn Header="Absolute Path" Binding="{Binding Path}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
