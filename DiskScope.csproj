<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ArborGraph</AssemblyName>
    <ApplicationTitle>ArborGraph</ApplicationTitle>
    <AssemblyTitle>ArborGraph</AssemblyTitle>
    <ApplicationIcon>Resources\ArborGraph.ico</ApplicationIcon>
    <Product>ArborGraph Filesystem Analytics &amp; Visualization</Product>
    <Description>ArborGraph Filesystem Analytics &amp; Visualization</Description>
    <Copyright>Copyright © 2026 AG DIAZ EVANGELISTA</Copyright>
    <Version>1.3.2</Version>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\ArborGraph.ico" />
    <Resource Include="Resources\DiskScope.ico" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\arborgraph_sprout_bot.png" />
    <Resource Include="Resources\splash.png" />
    <Resource Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="core\**" />
    <Compile Remove="Models\**" />
    <Compile Include="Models\TreemapModels.cs" />
    <Compile Remove="Services\**" />
    <Compile Include="Services\FileActionService.cs;Services\UpdateService.cs" />
    <Compile Remove="Infrastructure\ObservableObject.cs;Infrastructure\SizeFormatter.cs" />
    <ProjectReference Include="core\ArborGraph.Core.csproj" />
    <Compile Remove="tests\**" />
    <Compile Remove="engine\**" />
    <Compile Remove="desktop\**" />
    <Compile Remove="dist\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
