<UserControl x:Class="DiskScope.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,32" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Scanner" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Real-time disk indexing, traversal monitoring, and filesystem telemetry" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 2. STATUS CARD / METRICS -->
            <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Target & State Line -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="TARGET: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding CurrentTargetDescription}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Grid.Column="1" Background="{StaticResource BrushAccentTint}" CornerRadius="3" Padding="8,3" MinWidth="75">
                            <TextBlock Text="{Binding Stats.State}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar Height="4" Margin="0,0,0,18"
                                 IsIndeterminate="{Binding IsScanning}"
                                 Foreground="{StaticResource BrushAccent}" 
                                 Background="{StaticResource BrushBgCardHover}" 
                                 BorderThickness="0"/>

                    <!-- Plain-Language Primary Metrics Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Files Scanned -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Files scanned" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Stats.FilesIndexed, Converter={StaticResource NumberFormatConverter}}" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Folders -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Folders" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Stats.DirectoriesProcessed, Converter={StaticResource NumberFormatConverter}}" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Speed -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Speed" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Stats.FormattedFilesPerSecond}" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Elapsed Time -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Elapsed" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Stats.FormattedElapsed}" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Secondary Metric Line -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Storage indexed: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Stats.FormattedLogicalBytes}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Skipped: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Stats.FilesSkipped, Converter={StaticResource NumberFormatConverter}, StringFormat='{}{0} files'}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,14"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start Scan" Command="{Binding StartScanCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}"
                                MinWidth="110" Padding="18,6" Margin="0,0,8,0"/>

                        <Button Content="Stop Scan" Command="{Binding StopScanCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                MinWidth="110" Padding="18,6" Margin="0,0,8,0"/>

                        <Button Content="Explore Files" Command="{Binding ExploreFilesCommand}" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Padding="14,6" Margin="0,0,8,0"/>

                        <Button Content="Review Cleanup" Command="{Binding ReviewCleanupCommand}" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. LIVE DIRECTORY FEED (Prominent, Always-Visible Traversal Console) -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Feed Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LIVE DIRECTORY FEED" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text=" (real-time traversal buffer)" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.DirectoriesVisited, Converter={StaticResource NumberFormatConverter}, StringFormat='{}Visited: {0}'}" 
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </Grid>

                    <!-- Current Directory Path -->
                    <Border Background="{StaticResource BrushBgCanvas}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CURRENT:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.CurrentDirectory, FallbackValue='—'}" 
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" 
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Rolling Buffer Feed -->
                    <ListBox ItemsSource="{Binding RecentDirectories}"
                             Background="{StaticResource BrushBgCanvas}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1"
                             FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                             Height="180"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 4. DIAGNOSTICS & INTEGRITY (Technical Summary) -->
            <Border Grid.Row="3" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="INTEGRITY: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding OverviewVM.IntegrityStatus}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource BrushAccent}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Offline, Deterministic SQLite WAL Traversal" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
