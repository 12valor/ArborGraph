<UserControl x:Class="DiskScope.Views.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:DiskScope.Infrastructure"
             xmlns:models="clr-namespace:DiskScope.Models"
             xmlns:vm="clr-namespace:DiskScope.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Interactive Visual Treemap" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Proportional squarified space map of your files and folders. Double-click any folder to zoom into its contents." 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E0F2FE" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
                    <TextBlock Text="{Binding FormattedTotalBytes, StringFormat='View Total: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                </Border>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- 2. BREADCRUMBS & NAVIGATION BAR -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Up button -->
                <Button Grid.Column="0" Content="⬆ Up" Command="{Binding NavigateUpCommand}" 
                        Style="{StaticResource ActionButtonStyle}" FontSize="11" Padding="8,4" Margin="0,0,10,0"/>

                <!-- Breadcrumb trail -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BreadcrumbItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Name}" 
                                            Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" 
                                            FontWeight="SemiBold" FontSize="12" Cursor="Hand" Padding="4,2">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Separator chevron -->
                                    <TextBlock Text="›" FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="4,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Column="2" Text="{Binding TotalVisibleItems, StringFormat='{}{0:N0} items'}" 
                           FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- 3. COLOR LEGEND BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Categories:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Videos -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#8B5CF6" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Videos" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Images -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#10B981" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Images" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Executables -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#F43F5E" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Executables / DLLs" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Archives -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#F59E0B" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Archives" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Documents -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#0284C7" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Documents" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Code -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#06B6D4" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Code" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Audio -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle Width="10" Height="10" Fill="#EC4899" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Audio" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Folders -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="10" Height="10" Fill="#334155" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Folder (Double-click)" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 4. TREEMAP CANVAS AREA -->
        <Border Grid.Row="3" x:Name="TreemapContainer" Background="#0F172A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <!-- Items Canvas -->
                <ItemsControl ItemsSource="{Binding Rectangles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            <Setter Property="Width" Value="{Binding Width}"/>
                            <Setter Property="Height" Value="{Binding Height}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TreemapRect}">
                            <Border Background="{Binding FillBrush}" 
                                    BorderBrush="{Binding BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="1"
                                    Margin="0.5"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Node_MouseLeftButtonDown">

                                <!-- Selection highlight -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FACC15"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- Tooltip -->
                                <Border.ToolTip>
                                    <ToolTip Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Padding="10,8">
                                        <StackPanel MaxWidth="360">
                                            <TextBlock Text="{Binding Item.Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Item.Path}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <Separator Background="#334155" Margin="0,2,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Item.Category, StringFormat='Category: {0}'}" FontSize="11" Foreground="#CBD5E1"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Item.FormattedSize}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Item.Percentage, StringFormat='Share of view: {0:F1}%'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>

                                <!-- Text label inside block -->
                                <Grid Margin="3" ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Label -->
                                    <TextBlock Grid.Row="0" Text="{Binding Item.Name}" 
                                               FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" 
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Sub-label (Size) -->
                                    <TextBlock Grid.Row="1" Text="{Binding Item.FormattedSize}" 
                                               FontSize="9" Foreground="#E2E8F0" Opacity="0.85"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               Visibility="{Binding ShowSubLabel, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State Prompt -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="{Binding Rectangles.Count, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="No indexed files found in this directory." FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Perform a scan or navigate to another folder to view storage." FontSize="12" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. BOTTOM DETAILS & ACTION BAR -->
        <Border Grid.Row="4" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,10,0,0"
                Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selected Item Metadata -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedNode.Item.Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <Border Background="#E2E8F0" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNode.Item.Category}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedNode.Item.Path}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding SelectedNode.Item.FormattedSize, StringFormat='Size: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding SelectedNode.Item.Percentage, StringFormat='  ({0:F2}% of view)'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open in Explorer" Command="{Binding OpenFileLocationCommand}" 
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="Copy Path" Command="{Binding CopyPathCommand}" 
                            Style="{StaticResource ActionButtonStyle}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
