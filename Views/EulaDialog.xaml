<Window x:Class="DiskScope.Views.EulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ArborGraph — End User License Agreement (EULA)" 
        Icon="pack://application:,,,/ArborGraph;component/Resources/ArborGraph.ico"
        Height="660" Width="740" MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgCanvas}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Border Grid.Row="0" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/ArborGraph;component/Resources/ArborGraph.ico" 
                       Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="End User License Agreement (EULA)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Please read the terms below carefully. You must accept these terms to run ArborGraph." 
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EULA TEXT CONTAINER -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="EulaTextBox" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         Foreground="{StaticResource BrushTextPrimary}" 
                         FontFamily="Segoe UI" 
                         FontSize="12.5" 
                         Cursor="Arrow"/>
            </ScrollViewer>
        </Border>

        <!-- CONSENT CONTROLS -->
        <StackPanel Grid.Row="2" Margin="0,12,0,10">
            <CheckBox x:Name="AgreeCheckBox" 
                      Content="I have read, understood, and accept the terms of this End User License Agreement"
                      FontWeight="SemiBold" 
                      FontSize="12.5" 
                      Foreground="{StaticResource BrushTextPrimary}"
                      Checked="OnAgreeCheckChanged" 
                      Unchecked="OnAgreeCheckChanged"/>
            <TextBlock x:Name="ReviewModeNotice" 
                       Text="You have previously accepted this agreement. This window is in view-only mode." 
                       FontSize="11.5" Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" 
                       Visibility="Collapsed" Margin="2,4,0,0"/>
        </StackPanel>

        <!-- FOOTER BAR -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Publisher: AG DIAZ EVANGELISTA" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="100% Offline • Zero Telemetry • Local Execution" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="DeclineButton" 
                            Content="Decline &amp; Exit" 
                            Click="OnDeclineClick" 
                            Style="{StaticResource DangerButtonStyle}" 
                            MinWidth="110" 
                            Margin="0,0,10,0"/>
                    <Button x:Name="AcceptButton" 
                            Content="Accept &amp; Continue" 
                            Click="OnAcceptClick" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            MinWidth="140" 
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
