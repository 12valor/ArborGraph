<Window x:Class="DiskScope.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DiskScope.ViewModels"
        xmlns:views="clr-namespace:DiskScope.Views"
        mc:Ignorable="d"
        Title="DiskScope — Windows Storage Analyzer" 
        Height="840" Width="1320" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgCanvas}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR: Clean & Neat -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drives Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Target Drives:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,10,0"/>
                    <ItemsControl ItemsSource="{Binding OverviewVM.Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Custom Path Input -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folder:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding CustomScanPath, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center" Height="28" Padding="6,0" FontSize="12"/>
                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCustomFolderCommand}" 
                            Style="{StaticResource ActionButtonStyle}" Height="28" Padding="10,0" Margin="6,0,0,0"/>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start Scan" Command="{Binding StartScanCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Stop Scan" Command="{Binding StopScanCommand}" 
                            Style="{StaticResource DangerButtonStyle}" Height="30" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Export Report ▾" Click="ExportButton_Click" 
                            Style="{StaticResource ActionButtonStyle}" Height="30" Padding="12,0">
                        <Button.ContextMenu>
                            <ContextMenu Background="{StaticResource BrushBgSurface}" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}">
                                <MenuItem Header="📄 Executive HTML Audit Report..." Command="{Binding ExportHtmlReportCommand}"/>
                                <MenuItem Header="📊 Full Audit Dump (JSON)..." Command="{Binding ExportJsonReportCommand}"/>
                                <Separator Background="{StaticResource BrushBorder}"/>
                                <MenuItem Header="📑 Indexed Files (CSV)..." Command="{Binding ExportFilesCsvCommand}"/>
                                <MenuItem Header="📑 Duplicate Groups (CSV)..." Command="{Binding DuplicatesVM.ExportCsvCommand}"/>
                                <MenuItem Header="📑 Cleanable Junk Targets (CSV)..." Command="{Binding JunkCleanerVM.ExportCsvCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="6,10">
                <StackPanel>
                    <Button Content="Overview" Command="{Binding NavigateCommand}" CommandParameter="Overview" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Analytics" Command="{Binding NavigateCommand}" CommandParameter="Analytics" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Largest Files" Command="{Binding NavigateCommand}" CommandParameter="LargestFiles" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Largest Folders" Command="{Binding NavigateCommand}" CommandParameter="LargestFolders" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="File Types" Command="{Binding NavigateCommand}" CommandParameter="FileTypes" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Old Files (180d+)" Command="{Binding NavigateCommand}" CommandParameter="OldFiles" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Duplicates" Command="{Binding NavigateCommand}" CommandParameter="Duplicates" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Junk &amp; Cache Cleaner" Command="{Binding NavigateCommand}" CommandParameter="JunkCleaner" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Visual Space Treemap" Command="{Binding NavigateCommand}" CommandParameter="Treemap" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Separator Background="{StaticResource BrushBorder}" Margin="6,8"/>

                    <Button Content="Photoshop Intelligence" Command="{Binding NavigateCommand}" CommandParameter="Photoshop" 
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="Scan Diagnostics &amp; Log" Command="{Binding NavigateCommand}" CommandParameter="ScanLog" 
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- ACTIVE VIEW CONTAINER -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                        <views:OverviewView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                        <views:AnalyticsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LargestFilesViewModel}">
                        <views:LargestFilesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LargestFoldersViewModel}">
                        <views:LargestFoldersView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FileTypesViewModel}">
                        <views:FileTypesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:OldFilesViewModel}">
                        <views:OldFilesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DuplicateViewModel}">
                        <views:DuplicatesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PhotoshopViewModel}">
                        <views:PhotoshopView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:JunkCleanerViewModel}">
                        <views:JunkCleanerView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TreemapViewModel}">
                        <views:TreemapView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ScanLogViewModel}">
                        <views:ScanLogView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- State Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushTextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverviewVM.Stats.State}" Value="Scanning">
                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverviewVM.Stats.State}" Value="Stopping">
                                        <Setter Property="Fill" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverviewVM.Stats.State}" Value="Completed">
                                        <Setter Property="Fill" Value="{StaticResource BrushAccent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverviewVM.Stats.State}" Value="Failed">
                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding OverviewVM.Stats.State}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Current Directory Text -->
                <TextBlock Grid.Column="2" Text="{Binding OverviewVM.Stats.CurrentDirectory}" 
                           FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Live Metrics Summary -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverviewVM.Stats.FilesIndexed, Converter={StaticResource NumberFormatConverter}, StringFormat='Files: {0}'}" 
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding OverviewVM.Stats.DirectoriesProcessed, Converter={StaticResource NumberFormatConverter}, StringFormat='Dirs: {0}'}" 
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding OverviewVM.Stats.FormattedLogicalBytes, StringFormat='Indexed: {0}'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding OverviewVM.Stats.FormattedFilesPerSecond}" 
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding OverviewVM.Stats.FormattedElapsed, StringFormat='Elapsed: {0}'}" 
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
