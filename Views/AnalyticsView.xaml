<UserControl x:Class="DiskScope.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:infra="clr-namespace:DiskScope.Infrastructure"
             xmlns:vm="clr-namespace:DiskScope.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32">

            <!-- HEADER -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Storage Analytics &amp; Intelligence" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Historical growth tracking, age breakdown, reclaimable storage, and category intelligence from SQLite index" 
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Refresh Button & Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRefreshedText}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Content="Refresh Analytics" Command="{Binding RefreshCommand}" 
                            Style="{StaticResource ActionButtonStyle}" Height="30" Padding="14,0"/>
                </StackPanel>
            </Grid>

            <!-- ROW 1: STORAGE USAGE & GROWTH GRAPH -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Storage Allocation & Indexed Footprint -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="STORAGE USAGE &amp; INDEX ALLOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                        
                        <Grid Margin="0,14,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total System Storage" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedTotalDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filesystem Used" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedUsedDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filesystem Free" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedFreeDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,2,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Storage Indexed by ArborGraph" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedIndexedBytes}" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" FontSize="13"/>
                        </Grid>

                        <!-- Proportion bar: Indexed vs Used -->
                        <Grid Height="8" Margin="0,0,0,8">
                            <ProgressBar Value="{Binding OverallPercentUsed, Mode=OneWay}" Maximum="100" 
                                         Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgCardHover}" BorderThickness="0"/>
                        </Grid>

                        <TextBlock Text="{Binding FormattedIndexedFiles, StringFormat='Indexed: {0} files accounted for in SQLite index'}" 
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Storage Growth Graph -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STORAGE GROWTH OVER TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Grid.Column="1" Text="Scan Checkpoints" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                        </Grid>

                        <!-- Growth Chart Area -->
                        <Grid Height="110" Margin="0,8,0,4">
                            <!-- Horizontal Guide Lines -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="10,12,10,0"/>
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" VerticalAlignment="Center" Margin="10,0,10,0"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" Margin="10,0,10,12"/>

                            <Canvas x:Name="ChartCanvas" ClipToBounds="True">
                                <!-- Area fill -->
                                <Polygon Points="{Binding PolygonPoints}" Opacity="0.12">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0067C0" Offset="0"/>
                                            <GradientStop Color="#FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>

                                <!-- Trend Polyline -->
                                <Polyline Points="{Binding PolylinePoints}" Stroke="#0067C0" StrokeThickness="2.5" 
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Interactive Data Point Dots -->
                                <ItemsControl ItemsSource="{Binding GrowthPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="-6,-6,0,0" ToolTipService.ShowDuration="10000" Cursor="Hand">
                                                <Grid.ToolTip>
                                                    <ToolTip Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                                                        <StackPanel Margin="4">
                                                            <TextBlock Text="{Binding DateLabel}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                                                            <TextBlock Text="{Binding FormattedBytes, StringFormat='Indexed: {0}'}" FontSize="11" Foreground="#0067C0" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FormattedFiles, StringFormat='Files: {0}'}" FontSize="11" Foreground="#475569"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#0067C0" StrokeThickness="2.5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="{Binding GrowthTrendMessage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 2: POTENTIALLY RECLAIMABLE STORAGE (Full Width Callout) -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="POTENTIALLY RECLAIMABLE STORAGE" FontSize="11" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                <TextBlock Text="Cleanup Opportunities" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Estimated Reclaimable: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FormattedTotalReclaimable}" FontSize="14" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Reclaimable Categories Grid -->
                    <ItemsControl ItemsSource="{Binding ReclaimableBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding ActionHint}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding FormattedCount, StringFormat='{}{0} files'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                        <TextBlock Grid.Column="3" Text="{Binding FormattedBytes}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ROW 3: FILE AGE ANALYTICS & FILE TYPE ANALYTICS (2 Columns) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: File Age Distribution -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="FILE AGE DISTRIBUTION (BY MODIFICATION)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding AgeBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Age label & description -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormattedCount, StringFormat='{}{0} files'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="8,1,0,0"/>

                                        <!-- Size and percentage -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding FormattedPercentage}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                        </StackPanel>

                                        <!-- Bar -->
                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="5" Margin="0,4,0,0"
                                                     Value="{Binding PercentageOfTotal}" Maximum="100"
                                                     Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgCardHover}" BorderThickness="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: File Type Breakdown -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="FILE CATEGORIES &amp; FORMAT BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Category}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormattedCount, StringFormat='{}{0} files'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="6,1,0,0"/>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding FormattedPercentage}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                        </StackPanel>

                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="4" Margin="0,3,0,0"
                                                     Value="{Binding StoragePercentage}" Maximum="100"
                                                     Foreground="#3B82F6" Background="{StaticResource BrushBgCardHover}" BorderThickness="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 4: LARGEST FOLDERS & PHOTOSHOP / DUPLICATE INTELLIGENCE (2 Columns) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Largest Folders Graph -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TOP FOLDERS CONSUMING STORAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding TopFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="4"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" 
                                                   VerticalAlignment="Center"/>

                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="4" Margin="0,4,0,0"
                                                     Value="{Binding PercentageOfTotal}" Maximum="100"
                                                     Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgCardHover}" BorderThickness="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Photoshop & Duplicate Intelligence -->
                <StackPanel Grid.Column="2">
                    <!-- Photoshop Card -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PHOTOSHOP &amp; ADOBE CACHE INTELLIGENCE" FontSize="11" FontWeight="Bold" Foreground="#7C3AED"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedPhotoshopBytes}" FontWeight="Bold" FontSize="12" Foreground="#7C3AED"/>
                            </Grid>

                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PSD Documents" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PsdCount, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>

                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PSB Large Documents" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PsbCount, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>

                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Adobe Cache, Temp &amp; Scratch" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedAdobeCacheBytes}" FontWeight="Bold" Foreground="#D97706" FontSize="12"/>
                            </Grid>

                            <!-- Largest Photoshop Files Sub-list -->
                            <TextBlock Text="Largest Photoshop Documents:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding LargestPhotoshopFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Duplicate Analytics Card -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DUPLICATE FILE REDUNDANCY" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedDuplicateWasted, StringFormat='{}{0} Wasted'}" FontWeight="Bold" FontSize="12" Foreground="#D97706"/>
                            </Grid>

                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Exact Size Collision Groups" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DuplicateGroupsCount, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Candidate Duplicate Files" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DuplicateFilesCount, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ROW 5: SCAN HISTORY (Full Width Table) -->
            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="HISTORICAL SCAN SESSIONS &amp; STORAGE GROWTH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="Saved in SQLite metadata index (retained up to 50 sessions)" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Content="Clear All History" Command="{Binding ClearScanHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,0" FontSize="11"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding ScanHistory}" AutoGenerateColumns="False" CanUserSortColumns="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Session ID" Binding="{Binding Id}" Width="75"/>
                            <DataGridTextColumn Header="Scan Date / Time" Binding="{Binding FormattedDate}" Width="140"/>
                            <DataGridTextColumn Header="Scanned Target" Binding="{Binding Roots}" Width="*"/>
                            <DataGridTextColumn Header="Files Indexed" Binding="{Binding FormattedFiles}" Width="100"/>
                            <DataGridTextColumn Header="Storage Indexed" Binding="{Binding FormattedBytes}" Width="110"/>
                            <DataGridTextColumn Header="Storage Delta" Binding="{Binding FormattedGrowth}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="85"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding ScanStatus}" Width="85"/>
                            <DataGridTemplateColumn Header="Action" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" FontSize="10" Padding="6,2" Height="22"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.DeleteScanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ROW 6: WHAT GREW? (STORAGE COMPARISON) -->
            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WHAT GREW? — STORAGE COMPARISON ACROSS SESSIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="Compare storage category footprints between two scan checkpoints to pinpoint what expanded or contracted" 
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Overall Change badge -->
                        <Border Grid.Column="1" Background="{StaticResource BrushBgCardHover}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Net Growth: " FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ComparisonResult.FormattedDelta}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Scan Selector Controls -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Older (Baseline) Scan Selector -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Baseline (Older) Scan:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ScanHistory}" SelectedItem="{Binding SelectedOlderScan}" Height="32">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding FormattedDate, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — " Foreground="{StaticResource BrushTextMuted}"/>
                                            <Run Text="{Binding FormattedBytes, Mode=OneWay}" Foreground="{StaticResource BrushAccent}"/>
                                            <Run Text=" (" Foreground="{StaticResource BrushTextMuted}"/>
                                            <Run Text="{Binding Roots, Mode=OneWay}" Foreground="{StaticResource BrushTextMuted}"/>
                                            <Run Text=")" Foreground="{StaticResource BrushTextMuted}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Newer (Comparison) Scan Selector -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Comparison (Newer) Scan:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ScanHistory}" SelectedItem="{Binding SelectedNewerScan}" Height="32">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding FormattedDate, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — " Foreground="{StaticResource BrushTextMuted}"/>
                                            <Run Text="{Binding FormattedBytes, Mode=OneWay}" Foreground="{StaticResource BrushAccent}"/>
                                            <Run Text=" (" Foreground="{StaticResource BrushTextMuted}"/>
                                            <Run Text="{Binding Roots, Mode=OneWay}" Foreground="{StaticResource BrushTextMuted}"/>
                                            <Run Text=")" Foreground="{StaticResource BrushTextMuted}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Category Delta Breakdown -->
                    <DataGrid ItemsSource="{Binding ComparisonResult.WhatGrew}" AutoGenerateColumns="False" CanUserSortColumns="True" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Baseline Scan Size" Binding="{Binding FormattedPrevious}" Width="140"/>
                            <DataGridTextColumn Header="Comparison Scan Size" Binding="{Binding FormattedCurrent}" Width="140"/>
                            <DataGridTextColumn Header="Growth Delta" Binding="{Binding FormattedDelta}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="File Count Delta" Binding="{Binding DeltaFiles, StringFormat='{}{0:+0;-0;0} files'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
