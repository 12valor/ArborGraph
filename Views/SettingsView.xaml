<UserControl x:Class="DiskScope.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:DiskScope.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1050">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & ACTIONS -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Engine preferences, path exclusions, deletion safety rules, and retention" 
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Padding="10,4"/>
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. GROUPED SUB-NAVIGATION TABS -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="General" Command="{Binding SelectSectionCommand}" CommandParameter="General"
                             IsChecked="True" Style="{StaticResource SegmentedTabButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="Scanning" Command="{Binding SelectSectionCommand}" CommandParameter="Scanning"
                             Style="{StaticResource SegmentedTabButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="Cleanup" Command="{Binding SelectSectionCommand}" CommandParameter="Cleanup"
                             Style="{StaticResource SegmentedTabButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="History" Command="{Binding SelectSectionCommand}" CommandParameter="History"
                             Style="{StaticResource SegmentedTabButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="Advanced" Command="{Binding SelectSectionCommand}" CommandParameter="Advanced"
                             Style="{StaticResource SegmentedTabButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- 3. SECTION CONTENT -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="16">
            <Grid>
                <!-- GENERAL SECTION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="General">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="GENERAL PREFERENCES" Style="{StaticResource SectionHeadingStyle}"/>

                        <TextBlock Text="DiskScope operates 100% locally and offline with zero background telemetry or cloud connections." 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"/>

                        <TextBlock Text="LEGAL &amp; LICENSE" Style="{StaticResource SectionHeadingStyle}" Margin="0,12,0,8"/>
                        <TextBlock Text="Licensed under the DiskScope End User License Agreement." 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>
                        <Button Content="View License Agreement (EULA)..." Command="{Binding ViewEulaCommand}" 
                                Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Padding="12,5"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- SCANNING SECTION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Scanning">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="SCANNING ENGINE" Style="{StaticResource SectionHeadingStyle}"/>

                        <CheckBox Content="Follow directory junctions and symbolic links" 
                                  IsChecked="{Binding FollowJunctions}" Margin="0,0,0,8"/>

                        <CheckBox Content="Include hidden files in scan index" 
                                  IsChecked="{Binding IncludeHiddenFiles}" Margin="0,0,0,8"/>

                        <CheckBox Content="Include system files in scan index" 
                                  IsChecked="{Binding IncludeSystemFiles}" Margin="0,0,0,14"/>

                        <Grid Margin="0,4,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Worker Concurrency (0 = Auto):" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="26" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Grid.Column="2" Text="Parallel indexing threads" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Separator Margin="0,0,0,14"/>

                        <!-- PATH EXCLUSIONS -->
                        <TextBlock Text="PATH EXCLUSIONS" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="Folders listed here will be skipped during scans and excluded from cleanup." 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding NewExclusionPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="26"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseExclusionFolderCommand}" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="10,0"/>
                            <Button Grid.Column="4" Content="Add Exclusion" Command="{Binding AddExclusionCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="12,0"/>
                        </Grid>

                        <Border Background="{StaticResource BrushBgCanvas}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="3" Padding="4" MaxHeight="140" Margin="0,0,0,6">
                            <ListBox ItemsSource="{Binding ExcludedPaths}" SelectedItem="{Binding SelectedExclusion, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontFamily="{StaticResource MonoFont}" Padding="4,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button Content="Remove Selected" Command="{Binding RemoveExclusionCommand}" Style="{StaticResource ActionButtonStyle}" 
                                HorizontalAlignment="Left" Padding="8,3"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- CLEANUP SECTION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Cleanup">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="CLEANUP &amp; DELETION SAFETY RULES" Style="{StaticResource SectionHeadingStyle}"/>

                        <CheckBox Content="Default to Windows Recycle Bin for cleanup actions (Recommended)" 
                                  IsChecked="{Binding DefaultToRecycleBin}" Margin="0,0,0,10"/>

                        <CheckBox Content="Require user confirmation before moving files to Recycle Bin" 
                                  IsChecked="{Binding RequireConfirmationForRecycleBin}" Margin="0,0,0,10"/>

                        <CheckBox Content="Require explicit confirmation for permanent deletions (&quot;This cannot be undone&quot;)" 
                                  IsChecked="{Binding RequireConfirmationForPermanent}" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- HISTORY SECTION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="History">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="SCAN HISTORY &amp; DATABASE RETENTION" Style="{StaticResource SectionHeadingStyle}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Retention Period (Days):" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="26" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Grid.Column="2" Text="Snapshots older than this are purged" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Scan Sessions to Keep:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxScanSessionsToKeep, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="26" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Grid.Column="2" Text="Maximum past scan snapshots retained" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Button Content="Clear All Scan History Records" Command="{Binding ClearAllHistoryCommand}" 
                                Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" Padding="12,5"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ADVANCED SECTION (Diagnostic Log Viewer) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Advanced">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LOGGING &amp; DIAGNOSTICS" Style="{StaticResource SectionHeadingStyle}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Verbosity:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevel, Mode=TwoWay}" Height="26"/>
                    </Grid>

                    <!-- Embedded Scan Log View -->
                    <Border Grid.Row="2" Background="{StaticResource BrushBgCanvas}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <views:ScanLogView DataContext="{Binding ScanLogVM}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Local, Offline-First" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
