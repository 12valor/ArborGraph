<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Minimal, Clean, Utilitarian Developer Utility Palette -->
    <Color x:Key="ColorBgCanvas">#FAFAFA</Color>
    <Color x:Key="ColorBgSurface">#FFFFFF</Color>
    <Color x:Key="ColorBgCard">#FFFFFF</Color>
    <Color x:Key="ColorBgCardHover">#F3F4F6</Color>
    <Color x:Key="ColorBgNavActive">#EAECEF</Color>
    <Color x:Key="ColorBorder">#E5E7EB</Color>
    <Color x:Key="ColorBorderLight">#F3F4F6</Color>
    
    <Color x:Key="ColorTextPrimary">#111827</Color>
    <Color x:Key="ColorTextSecondary">#4B5563</Color>
    <Color x:Key="ColorTextMuted">#9CA3AF</Color>

    <!-- Single Restrained Accent: Precision Steel Blue -->
    <Color x:Key="ColorAccent">#005FB8</Color>
    <Color x:Key="ColorAccentHover">#004C99</Color>
    <Color x:Key="ColorAccentTint">#EFF6FF</Color>
    <Color x:Key="ColorAccentTintBorder">#BFDBFE</Color>

    <!-- Semantic Status (Used only for actual state, strictly non-decorative) -->
    <Color x:Key="ColorSuccess">#15803D</Color>
    <Color x:Key="ColorWarning">#B45309</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>

    <!-- Muted Tonal Scale for Treemap/Visualization -->
    <Color x:Key="ColorTone1">#F3F4F6</Color>
    <Color x:Key="ColorTone2">#E5E7EB</Color>
    <Color x:Key="ColorTone3">#D1D5DB</Color>
    <Color x:Key="ColorTone4">#9CA3AF</Color>
    <Color x:Key="ColorTone5">#6B7280</Color>
    <Color x:Key="ColorTone6">#4B5563</Color>
    <Color x:Key="ColorTone7">#374151</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgCanvas" Color="{StaticResource ColorBgCanvas}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}"/>
    <SolidColorBrush x:Key="BrushBgNavActive" Color="{StaticResource ColorBgNavActive}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="BrushAccentTint" Color="{StaticResource ColorAccentTint}"/>
    <SolidColorBrush x:Key="BrushAccentTintBorder" Color="{StaticResource ColorAccentTintBorder}"/>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>

    <SolidColorBrush x:Key="BrushTone1" Color="{StaticResource ColorTone1}"/>
    <SolidColorBrush x:Key="BrushTone2" Color="{StaticResource ColorTone2}"/>
    <SolidColorBrush x:Key="BrushTone3" Color="{StaticResource ColorTone3}"/>
    <SolidColorBrush x:Key="BrushTone4" Color="{StaticResource ColorTone4}"/>
    <SolidColorBrush x:Key="BrushTone5" Color="{StaticResource ColorTone5}"/>
    <SolidColorBrush x:Key="BrushTone6" Color="{StaticResource ColorTone6}"/>
    <SolidColorBrush x:Key="BrushTone7" Color="{StaticResource ColorTone7}"/>

</ResourceDictionary>
