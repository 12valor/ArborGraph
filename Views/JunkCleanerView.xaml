<UserControl x:Class="DiskScope.Views.JunkCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:DiskScope.Infrastructure"
             xmlns:models="clr-namespace:DiskScope.Models"
             xmlns:vm="clr-namespace:DiskScope.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="System &amp; Developer Junk Cleaner" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                <TextBlock Text="Safely scan and clean temporary files, crash dumps, browser caches, and developer package stores." 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Actions Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,12,0"/>

                <Button Content="Scan Caches" Command="{Binding ScanCommand}" 
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Padding="14,7"/>

                <Button Content="{Binding FormattedPotentialBytes, StringFormat='Clean Selected ({0})'}" 
                        Command="{Binding CleanCommand}" 
                        Style="{StaticResource AccentButtonStyle}" Padding="16,7"/>

                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Cleanable -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="TOTAL CLEANABLE SPACE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="{Binding FormattedFoundBytes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding TotalFoundFiles, StringFormat='{}{0:N0} candidate files discovered'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Selected to Clean -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="SELECTED TO CLEAN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                    <TextBlock Text="{Binding FormattedPotentialBytes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding TotalPotentialFiles, StringFormat='{}{0:N0} files will be deleted'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Status / Safe Skipping Note -->
            <Border Grid.Column="4" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="SAFETY ENGINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock Text="Locked &amp; In-Use Protection Active" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2"/>
                    <TextBlock Text="Active apps (open browsers, running compilers, active temp locks) are bypassed automatically without errors." 
                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PROGRESS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Background="#E2E8F0" Foreground="{StaticResource BrushAccent}"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT (Split View: Categories List + File Inspector Drawer) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Categorized Targets List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding CategoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:JunkCategoryGroup}">
                            <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="14">
                                <StackPanel>
                                    <!-- Category Header -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding TotalFiles, StringFormat=' ({0:N0} files)'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding FormattedTotalBytes}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                        </Border>
                                    </Grid>

                                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,10"/>

                                    <!-- Targets Inside Category -->
                                    <ItemsControl ItemsSource="{Binding Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:JunkTarget}">
                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                        <!-- Name & Description -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="8,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Size & Count Badge -->
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0:N0} files'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                                        </StackPanel>

                                                        <!-- Action Buttons -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Inspect Files" 
                                                                    Command="{Binding DataContext.InspectTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ActionButtonStyle}" 
                                                                    FontSize="11" Padding="8,4" Margin="0,0,6,0"/>

                                                            <Button Content="Open Folder" 
                                                                    Command="{Binding DataContext.OpenTargetFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ActionButtonStyle}" 
                                                                    FontSize="11" Padding="8,4"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- RIGHT: File Inspector Drawer -->
            <Border Grid.Column="1" Width="440" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0"
                    Visibility="{Binding HasSelectedTarget, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Inspector Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedTarget.Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="{Binding SelectedTarget.DiscoveredFiles.Count, StringFormat='Showing {0:N0} files'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕" Command="{Binding ClosePreviewCommand}" 
                                Width="26" Height="26" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Cursor="Hand"/>
                    </Grid>

                    <!-- Files Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedTarget.DiscoveredFiles}" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                              RowHeight="26" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="75"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
