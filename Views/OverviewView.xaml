<UserControl x:Class="DiskScope.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:DiskScope.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER & ACTIONS -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Storage Overview" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Storage allocation, largest contributors, and cleanup opportunities" 
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start Scan" Command="{Binding StartScanCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="Review Cleanup" Command="{Binding ReviewCleanupCommand}" 
                            Style="{StaticResource ActionButtonStyle}" Padding="14,6"/>
                </StackPanel>
            </Grid>

            <!-- 2. SYSTEM RESOURCE MONITORING (Thin, subtle technical sparklines) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="SYSTEM RESOURCES" Style="{StaticResource SectionHeadingStyle}"/>

                <Grid x:Name="ResourceGrid" SizeChanged="ResourceGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="Col0" Width="*"/>
                        <ColumnDefinition x:Name="Col1" Width="14"/>
                        <ColumnDefinition x:Name="Col2" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="RowGap" Height="0"/>
                        <RowDefinition x:Name="Row1" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CPU Monitor Card -->
                    <Border x:Name="CpuCard" Grid.Row="0" Grid.Column="0" 
                            Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentCpuText}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>

                            <controls:RealtimeMetricGraph Grid.Row="1" Margin="0,4,0,4"
                                                          Values="{Binding CpuHistory}"
                                                          LineColor="#005FB8"
                                                          MaxValue="100" MinValue="0"
                                                          MaxPoints="60"
                                                          StrokeThickness="1.0"/>

                            <Grid Grid.Row="2">
                                <TextBlock Text="60 sec" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding CpuPeakText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RAM Monitor Card -->
                    <Border x:Name="RamCard" Grid.Row="0" Grid.Column="2" 
                            Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentRamText}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>

                            <controls:RealtimeMetricGraph Grid.Row="1" Margin="0,4,0,4"
                                                          Values="{Binding RamHistory}"
                                                          LineColor="#4B5563"
                                                          MaxValue="{Binding DynamicRamMaxCeiling}" MinValue="0"
                                                          MaxPoints="60"
                                                          StrokeThickness="1.0"/>

                            <Grid Grid.Row="2">
                                <TextBlock Text="60 sec" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding RamCeilingText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 3. CORE 3-QUESTION SPLIT: STATUS & ACTION (Left) vs DIRECTORY DRILLDOWN (Right) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: How much storage? What is using it? What can I do? -->
                <StackPanel Grid.Column="0">

                    <!-- QUESTION 1: Storage Allocation -->
                    <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="STORAGE UTILIZATION" Style="{StaticResource SectionHeadingStyle}"/>

                            <!-- Used / Free / Total Rows -->
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Storage used" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedUsedDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Storage free" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedFreeDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>

                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total capacity" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormattedTotalDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>

                            <!-- Clean single-color progress bar -->
                            <ProgressBar Height="4" Value="{Binding OverallPercentUsed, Mode=OneWay}" Maximum="100" 
                                         Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgCardHover}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- QUESTION 2: Largest Contributors -->
                    <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LARGEST CONTRIBUTORS" Style="{StaticResource SectionHeadingStyle}"/>

                            <ItemsControl ItemsSource="{Binding Explanation.LargestContributors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource MonoFont}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty message when no contributors yet -->
                            <TextBlock Text="Run a scan to analyze contributors." 
                                       Visibility="{Binding Explanation.LargestContributors.Count, Converter={StaticResource InverseBoolToVis}}"
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- QUESTION 3: Potential Cleanup Action -->
                    <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="16">
                        <StackPanel>
                            <TextBlock Text="POTENTIAL CLEANUP" Style="{StaticResource SectionHeadingStyle}"/>

                            <Grid Margin="0,2,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Recoverable space:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Explanation.FormattedReclaimable, FallbackValue='0 B'}" 
                                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>

                            <Button Content="Review Cleanup" Command="{Binding ReviewCleanupCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    HorizontalAlignment="Left" Padding="14,6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Interactive Directory Drilldown ("What is using C:\") -->
                <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="DIRECTORY BREAKDOWN" Style="{StaticResource SectionHeadingStyle}"/>
                        </Grid>

                        <!-- Breadcrumb & Navigation Toolbar -->
                        <Border Grid.Row="1" Background="{StaticResource BrushBgCanvas}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="⮤ Up" Command="{Binding DrillUpCommand}" 
                                        Style="{StaticResource ActionButtonStyle}" FontSize="11" Padding="8,2" Margin="0,0,8,0"/>

                                <!-- Breadcrumb Trail -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text=" / " Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="2,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Column="2" Content="Reset" Command="{Binding ResetDrilldownCommand}" 
                                        Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="6,2"/>
                            </Grid>
                        </Border>

                        <!-- Directory Rows -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DrilldownItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="6,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedPercentage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <Button Grid.Column="3" Content="Drill Down" 
                                                        Command="{Binding DataContext.DrilldownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanDrillDown}"
                                                        Style="{StaticResource ActionButtonStyle}" FontSize="11" Padding="8,3"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. LIVE SCAN TRAVERSAL FEED -->
            <Border Grid.Row="3" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LIVE DIRECTORY FEED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text=" (real-time traversal)" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.CurrentDirectory, FallbackValue='Ready'}" 
                                   FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextMuted}" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding RecentDirectories}"
                             Background="{StaticResource BrushBgCanvas}" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1"
                             FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                             Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" Padding="2,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 5. SUBTLE INTEGRITY FOOTER -->
            <Border Grid.Row="4" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="INTEGRITY: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding IntegrityStatus}" FontSize="11" Foreground="{StaticResource BrushAccent}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Offline, Deterministic SQLite Index" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
