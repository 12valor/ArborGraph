<UserControl x:Class="DiskScope.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Storage Overview" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Text="Filesystem allocation and SQLite index scan accounting" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Top Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Physical Disk Volume -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="DRIVE ALLOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                    <Grid Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filesystem Used" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding FormattedUsedDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filesystem Free" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding FormattedFreeDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filesystem Total" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding FormattedTotalDrive}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                    </Grid>

                    <!-- Drive progress bar -->
                    <ProgressBar Height="6" Value="{Binding OverallPercentUsed, Mode=OneWay}" Maximum="100" 
                                 Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBgCardHover}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Exact Scan Accounting -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="SCAN ACCOUNTING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                    
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Files Indexed" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.FilesIndexed, Converter={StaticResource NumberFormatConverter}}" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Files Skipped" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.FilesSkipped, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushWarning}" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dirs Processed" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.DirectoriesProcessed, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dirs Skipped" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.DirectoriesSkipped, Converter={StaticResource NumberFormatConverter}}" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushWarning}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Performance & Live Metrics -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="SCAN STATUS &amp; SPEED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>

                    <Grid Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Storage Indexed" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.FormattedLogicalBytes}" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Scan State" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.State}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Elapsed Time" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.FormattedElapsed}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Throughput" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Stats.FormattedFilesPerSecond}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Live Directory Rolling Feed -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LIVE DIRECTORY FEED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text=" (recent traversal buffer)" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Stats.CurrentDirectory}" Foreground="{StaticResource BrushTextMuted}" 
                               FontSize="11" FontFamily="Consolas" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding RecentDirectories}"
                         Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                         FontFamily="Consolas" FontSize="11" Foreground="#334155"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Padding="2,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Scan Integrity Panel -->
        <Border Grid.Row="3" Margin="0,14,0,0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SCAN INTEGRITY:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding IntegrityStatus}" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Logical Indexed Size vs Filesystem: differences expected for metadata, reserved space, and excluded folders."
                               FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
